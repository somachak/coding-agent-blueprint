# Copy this file to .env and paste your real key. .env is git-ignored.

# Any OpenAI-compatible endpoint works. OpenRouter is the default because
# one key gives you every model.
LLM_API_KEY=paste-your-openrouter-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1

# The model id, exactly as the provider names it.
# OpenRouter examples: openai/gpt-5-mini, anthropic/claude-sonnet-4.5, google/gemini-2.5-flash
LLM_MODEL=openai/gpt-5-mini

# Where the agent is allowed to read, write and run commands. Relative to this folder.
AGENT_WORKSPACE=workspace

# Safety brake: how many model calls one user message may trigger before we stop.
AGENT_MAX_STEPS=25

# Roughly how many tokens the model can read at once. The agent shrinks old
# messages when the conversation passes 80% of this. 0 turns that off.
AGENT_CONTEXT_WINDOW=120000
